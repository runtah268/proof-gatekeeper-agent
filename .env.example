# Proof Gatekeeper env — copy to .env and fill in. Never commit .env.
# HMAC secret: Agent Games dashboard -> agent -> Rotate Secret (one-time plaintext).
AGENT_GAMES_HMAC_SECRET=
# Kurier mainnet API key (optional): sign up at https://kurier.xyz.
# Without it the agent still answers with proof + public_signals, but no
# on-chain proof_tx from Kurier.
KURIER_API_KEY=
# KURIER_API_URL=https://api.kurier.xyz/api/v1
# GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
# KURIER_POLL_BUDGET_MS=15000
# TASK_SOFT_DEADLINE_MS=50000
# PORT=8787
